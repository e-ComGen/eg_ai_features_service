app/services/enrichment/strategies/dictionaries/data/*.json
app/services/enrichment/strategies/dictionaries/data/*.json.gz
app/services/enrichment/strategies/dictionaries/data/*.partial
app/services/enrichment/strategies/dictionaries/data/*.values_partial

# Runtime logs
logs/

# LLM disk cache (содержит реальные ответы LLM, может быть приватным)
