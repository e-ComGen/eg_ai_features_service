# Eval artifacts (большие JSON отчёты, генерятся при прогоне)
scripts/eval_results/

# Local Claude Code settings (must not go to repo)
.claude/

# Debug artifacts (HTML dumps, nuxt state snapshots)
_dump_*.html
_nuxt_state*.json

# RunPod runtime resume state files
scripts/.runpod_*_state.json

# Test fixtures (CSV/XLSX samples for scripts)
